{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ parameter, %@" : {
      "comment" : "VoiceOver hint of a parameter's field: where it goes, then its type, such as: path parameter, string.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ parameter, %2$@"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "A parameter's location and type, such as: path · string.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@: %@ %@, in %@ %@." : {
      "comment" : "What an operation is, for the chat, before any call",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ %3$@, in %4$@ %5$@."
          }
        }
      }
    },
    "%@: %@ %@, in %@ %@. Its last call answered %lld after %@." : {
      "comment" : "What an operation is, for the chat. Pay for an order: POST /orders/{id}/checkout, in Orders API 1.4.0. Its last call answered 504 after 4.2 sec.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ %3$@, in %4$@ %5$@. Its last call answered %6$lld after %7$@."
          }
        }
      }
    },
